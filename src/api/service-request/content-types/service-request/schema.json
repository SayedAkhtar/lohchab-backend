{
  "kind": "collectionType",
  "collectionName": "service_requests",
  "info": {
    "singularName": "service-request",
    "pluralName": "service-requests",
    "displayName": "Service Request",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "brand": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::brand.brand"
    },
    "vehicle_type": {
      "type": "string",
      "required": true
    },
    "workshop": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::workshop.workshop"
    },
    "model": {
      "type": "string",
      "required": true
    },
    "phone_number": {
      "required": true,
      "type": "biginteger"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "time": {
      "type": "time",
      "required": true
    }
  }
}
