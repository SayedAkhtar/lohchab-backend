{
  "kind": "collectionType",
  "collectionName": "brands",
  "info": {
    "singularName": "brand",
    "pluralName": "brands",
    "displayName": "Brands",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "cars": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::car.car",
      "mappedBy": "brand"
    },
    "promotional_banner": {
      "displayName": "Promotional Banner",
      "type": "component",
      "repeatable": true,
      "component": "promotional-banner.promotional-banner",
      "required": true
    },
    "is_parent": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "parent_brand": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::brand.brand",
      "inversedBy": "brand"
    },
    "brand": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::brand.brand",
      "inversedBy": "parent_brand"
    },
    "available_sections": {
      "type": "customField",
      "options": [
        "Range",
        "Newly Added",
        "Top Selling"
      ],
      "customField": "plugin::multi-select.multi-select",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "types_available": {
      "type": "customField",
      "options": [
        "Car",
        "Scooter",
        "Pick Up",
        "SUV",
        "e-SUV",
        "Bike",
        "LLM"
      ],
      "customField": "plugin::multi-select.multi-select"
    },
    "offers": {
      "type": "component",
      "repeatable": true,
      "component": "offer.offers"
    }
  }
}
